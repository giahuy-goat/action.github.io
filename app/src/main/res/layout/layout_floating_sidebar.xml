<?xml version="1.0" encoding="utf-8"?>
<com.gamecorner.app.WingHudLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hudPanel"
    android:layout_width="match_parent"
    android:layout_height="142dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/modeRow"
        android:layout_width="220dp"
        android:layout_height="31dp"
        android:layout_gravity="top|center_horizontal"
        android:gravity="center"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/hudModeLabel"
        android:layout_width="86dp"
        android:layout_height="22dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="31dp"
        android:gravity="center"
        android:text="X-MODE"
        android:textColor="@color/gc_red_bright"
        android:textSize="8sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/hudBody"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cpuMonitor"
            android:layout_width="54dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_cyberpunk_panel"
            android:gravity="center"
            android:text="CPU\n1,90 GHz"
            android:textColor="@color/gc_text"
            android:textSize="8sp"
            android:textStyle="bold" />

        <GridLayout
            android:id="@+id/leftUtilityGrid"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:columnCount="3"
            android:rowCount="2"
            android:useDefaultMargins="false" />

        <LinearLayout
            android:id="@+id/hudCenter"
            android:layout_width="102dp"
            android:layout_height="68dp"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:contentDescription="ROG"
                android:src="@drawable/app_logo" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="GAME CORNER"
                android:textColor="@color/gc_text"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PERFORMANCE HUD"
                android:textColor="@color/gc_muted"
                android:textSize="6sp" />
        </LinearLayout>

        <GridLayout
            android:id="@+id/rightUtilityGrid"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:columnCount="3"
            android:rowCount="2"
            android:useDefaultMargins="false" />

        <TextView
            android:id="@+id/ramMonitor"
            android:layout_width="54dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_cyberpunk_panel"
            android:gravity="center"
            android:text="RAM\n3,2 / 8 GB"
            android:textColor="@color/gc_text"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.gamecorner.app.WingHudLayout>