<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#6633373D" />
            <stroke android:width="1dp" android:color="#664C4D55" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/gc_red_bright" />
            <stroke android:width="2dp" android:color="@color/gc_orange" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/gc_red" />
            <stroke android:width="1dp" android:color="@color/gc_red_bright" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</selector>